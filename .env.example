# 이 파일을 .env 로 복사해서 씁니다. .env 는 커밋하지 않습니다.

# ── 실행 모드 ────────────────────────────────────────────────────────────────
# serve  : 운영. LLM 없이 임베딩 + 검색만. QA 생성/평가 탭이 숨겨집니다.
# studio : 사내 작업용 PC. QA 사전 생성·평가까지 가능.
APP_MODE=serve

# ── 관리자 인증 (필수) ───────────────────────────────────────────────────────
# 운영 배포 전 반드시 바꾸세요. 기본값이면 기동 시 경고가 남습니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── 임베딩 (ONNX · 앱 안에서 돕니다) ─────────────────────────────────────────
# serve 모드에서도 필요합니다 — 질문을 벡터로 만들어야 검색이 됩니다.
# **Ollama 로는 임베딩하지 않습니다.** 같은 bge-m3 라도 실행 방식이 다르면 벡터가 달라져
# (실측 코사인 0.984) 색인과 검색이 조용히 어긋납니다. 그래서 선택지를 두지 않았습니다.
#
#   python scripts/fetch_onnx_model.py    ← 처음 한 번. 약 565MB
#   폐쇄망은 이 폴더를 통째로 복사해 넣으면 됩니다.
#
# 모델을 바꾸면 **반드시 재색인**하세요(양자화만 달라도 벡터가 달라집니다).
EMBED_ONNX_DIR=./models/bge-m3-onnx
# 토크나이저가 자르는 기준(토큰). 줄이면 CPU 색인이 빨라집니다.
EMBED_MAX_TOKENS=512
# 청크가 이 길이(자)를 넘으면 위 상한에 걸려 뒷부분이 조용히 잘릴 수 있습니다.
# 자르지 않고 로그로만 알립니다. 대응은 그 절에 소제목을 넣어 문서를 나누는 것입니다.
EMBED_WARN_CHARS=1800

# ── Ollama (LLM 전용 · studio) ───────────────────────────────────────────────
# 질문·답변·채점에만 씁니다. **운영에는 필요 없습니다.**
OLLAMA_HOST=http://localhost:11434
# studio 전용. serve 모드에서는 로드하지 않습니다. 아래 역할별 값이 비었을 때 쓰입니다.
OLLAMA_LLM_MODEL=gemma4:latest
# 역할별 모델(비우면 위 값). 같은 문서로 재본 결과 강점이 반대였습니다 —
#   답변    : 큰 모델이 근거를 빠짐없이 서술합니다
#   질문·변형: 작은 모델이 구어체·명사 나열까지 섞어 표현 폭이 넓습니다.
#             적중률은 변형 질문의 표현 폭이 사실상 결정합니다
# 관리자 화면 탭 ⑥에서 실행할 때마다 바꿀 수도 있습니다.
OLLAMA_QUESTION_MODEL=
OLLAMA_ANSWER_MODEL=
# 추론(thinking) 모델은 사고 과정만 내보내고 본문을 비웁니다 — 답변이 통째로 사라집니다.
OLLAMA_THINK=false
# 프롬프트가 이 창을 넘으면 초과분이 **조용히** 잘립니다. 발췌를 미리 자르는 기준이기도 합니다.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024

# ── 매칭 임계값 (관리자 화면에서도 바꿀 수 있습니다) ──────────────────────────
# 이 값 이상이면 검수된 답변을 그대로 보여줍니다.
QA_MATCH_THRESHOLD=0.90
# 답변에 못 미쳐도 이 값 이상인 문서가 있으면 문서만 보여줍니다.
# 반드시 QA_MATCH_THRESHOLD 보다 낮아야 합니다.
RELATED_DOCS_FLOOR=0.55
RELATED_DOCS_COUNT=3

LOG_LEVEL=INFO
# 애플리케이션 로그(JSON 한 줄에 한 건). 5MB 씩 5개까지 회전합니다.
# 저장소 밖으로 빼면 저장소를 다시 받아도 로그가 남습니다. 개발 PC 기준 예시이며,
# 운영(Linux)은 기본값(./data/logs/app.jsonl)이나 컨테이너 볼륨 경로를 씁니다.
LOG_FILE=C:/chatapp/logs/app.jsonl
