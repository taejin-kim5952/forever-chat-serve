# 이 파일을 .env 로 복사해서 씁니다. .env 는 커밋하지 않습니다.

# ── 실행 모드 ────────────────────────────────────────────────────────────────
# serve  : 운영. LLM 없이 임베딩 + 검색만. QA 생성/평가 탭이 숨겨집니다.
# studio : 사내 작업용 PC. QA 사전 생성·평가까지 가능.
APP_MODE=serve

# ── 관리자 인증 (필수) ───────────────────────────────────────────────────────
# 운영 배포 전 반드시 바꾸세요. 기본값이면 기동 시 경고가 남습니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
# serve 모드에서도 필요합니다 — 질문을 벡터로 만들어야 검색이 됩니다.
OLLAMA_EMBED_MODEL=bge-m3:latest
# studio 전용. serve 모드에서는 로드하지 않습니다.
OLLAMA_LLM_MODEL=gemma4:latest

# ── 매칭 임계값 (관리자 화면에서도 바꿀 수 있습니다) ──────────────────────────
# 이 값 이상이면 검수된 답변을 그대로 보여줍니다.
QA_MATCH_THRESHOLD=0.90
# 답변에 못 미쳐도 이 값 이상인 문서가 있으면 문서만 보여줍니다.
# 반드시 QA_MATCH_THRESHOLD 보다 낮아야 합니다.
RELATED_DOCS_FLOOR=0.55
RELATED_DOCS_COUNT=3

LOG_LEVEL=INFO
