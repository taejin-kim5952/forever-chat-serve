# 개발 서버에 올릴 때 쓰는 설정
#
# 이 PC(.env)와 **다른 곳만** 적었습니다. 나머지는 .env.example 을 보세요.
#
# 구성: 서버가 **같은 사내망의 AI 테스트 PC**에 있는 Ollama 를 봅니다.
#
#     사용자 ─→ 개발 서버(이 설정) ─── 11434 ──→ AI 테스트 PC(Ollama)
#                      │
#                      └ 검수된 답변·질문 이력·자료는 서버 안에서 끝납니다
#
# 1차(forever-chat)가 이미 이 방식으로 올라가 있습니다. docs/06-설정.md 의
# "Ollama 가 다른 PC에 있을 때" 가 이 자리입니다.

# ── 반드시 바꿀 것 ───────────────────────────────────────────────────────────

# ★ serve 가 아니라 studio 입니다.
#
# 이 코드에서 모드는 "이 기계에 GPU 가 있나"가 아니라 **"이 설치가 LLM 을 쓰나"** 입니다.
# serve 로 두면 OLLAMA_HOST 를 맞춰도 `/api/models` 가 빈 목록을 돌려주고 화면이 AI 답변
# 스위치를 잠급니다(app/api/chat_stream.py).
#
# studio 로 띄우면 QA 생성·품질 평가·문서 편집도 서버에서 열립니다. 관리자 인증 뒤이지만,
# 수십 분짜리 생성 배치를 **서버가 그 PC 의 GPU 로** 돌리게 된다는 뜻입니다.
APP_MODE=studio

# ★ AI 테스트 PC 의 주소. localhost 가 아닙니다.
#
# 그 PC 에서 Ollama 가 바깥으로 들으려면 OLLAMA_HOST=0.0.0.0 (Ollama 자신의 환경변수)
# 으로 띄우고 방화벽 11434 를 열어야 합니다. 주소가 바뀌면 여기도 바꿔야 하므로
# 고정 IP 나 호스트 이름을 쓰세요.
OLLAMA_HOST=http://<AI-테스트-PC-주소>:11434

# ★ 기본은 '검수된 답변' 입니다.
#
# 이 PC 에서는 true 로 두고 씁니다. 서버에서 true 면 **AI 테스트 PC 가 꺼지는 순간 모든
# 사용자의 기본 경험이 멈춥니다.** false 로 두면 검수된 답변(0.6초)이 기본이고, 필요한
# 사람이 스위치를 켭니다. 켠 상태에서 PC 가 꺼져 있으면 화면이 스위치를 잠그고 검수 답변
# 으로 떨어집니다 — 그 동작은 이미 들어가 있습니다.
AI_ANSWER_DEFAULT=false

# ★ 서버의 비밀번호는 이 PC 와 다르게 두세요.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── 서버 경로 ────────────────────────────────────────────────────────────────

# 컨테이너 안 경로입니다. 호스트의 data/ 를 볼륨으로 붙입니다(docker-compose.yml).
LOG_FILE=/app/data/logs/app.jsonl

# ── 그대로 두는 것 ───────────────────────────────────────────────────────────

# 모델은 이 PC 와 같아야 합니다. 답변 모델이 다르면 같은 질문에 다른 글이 나오고,
# 어느 쪽이 맞는지 비교할 수가 없습니다.
OLLAMA_LLM_MODEL=gemma4:latest
OLLAMA_QUESTION_MODEL=gemma4:latest
OLLAMA_ANSWER_MODEL=gemma4:latest
OLLAMA_JUDGE_MODEL=qwen3:4b

# 임계값은 실측으로 정한 값입니다(scripts/tune_search.py). 서버에서 임의로 바꾸면
# 이 PC 에서 잰 숫자와 운영 동작이 어긋납니다.
QA_MATCH_THRESHOLD=0.90
RELATED_DOCS_FLOOR=0.55
RELATED_DOCS_COUNT=3

APP_NAME=지식LAB
APP_LOGO=FS

# ── 올리기 전에 ──────────────────────────────────────────────────────────────
#
# 1. 리눅스에서는 먼저:  sudo chown -R 10001:10001 data/
#    컨테이너가 비루트로 돌아서, 안 맞추면 조회는 되는데 승인·설정 저장이 조용히 실패합니다.
# 2. AI 테스트 PC 에서:  curl http://<PC주소>:11434/api/tags   ← 서버에서 이게 돼야 합니다
# 3. 올린 뒤 질문 하나를 던져 워밍업하세요. 첫 질문은 모델 적재로 10초쯤 걸립니다.
